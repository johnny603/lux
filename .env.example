# Copy to .env for local Compose use. Never commit real secrets.
LUX_PORT=5050
LUX_SECRET_KEY=replace-with-a-long-random-value
LUX_CSRF_SECRET_KEY=replace-with-a-second-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://lux:lux@db:5432/lux
LUX_DOCKER_RUNTIME=runc
LUX_SANDBOX_AUDIT_LOG=/var/log/lux/sandbox-audit.jsonl
LUX_OLLAMA_MODEL=llama3.2
